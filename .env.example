# Copy to .env (chmod 600). Never commit real values. Every key is optional; missing ones just switch that feature off.

# --- .env (read by bridge/config.load_env) ---
# Notion integration token (inbox widget, notion_sync.py, Notion task actions)
NOTION_TOKEN=
# Notion database id of your Email Tasks database
NOTION_EMAIL_TASKS_DB=
# TypeSafe (Jev) classifier key; falls back to the Ai Workload repo's .env
TYPESAFE_API_KEY=
# Groq free-tier key (Tier 4)
GROQ_API_KEY=
# OpenRouter key (Tier 4)
OPENROUTER_API_KEY=
# Bright Data API key (morning intel fetch, optional)
BRIGHTDATA_API_KEY=
# Bright Data Web Unlocker zone name (used with BRIGHTDATA_API_KEY)
WEB_UNLOCKER_ZONE=
# Apify token (morning intel fetch, optional)
APIFY_TOKEN=
# Obsidian Local REST API key (scripts/obsidian_mcp.sh)
OBSIDIAN_API_KEY=

# --- process environment (export in your shell; not read from .env) ---
# 1 = no network: fake providers/widgets (tests, demo)
AOS_OFFLINE=
# Path to requests.db; its parent becomes the data dir (default: ./data/requests.db)
AOS_DB=
# Obsidian vault path (default: config.json vault_path, ~/Claude+Obsidian)
AOS_VAULT=
# Path to the Ai Workload repo that provides the router package (default: ~/Ai Workload)
AOS_AI_WORKLOAD=
