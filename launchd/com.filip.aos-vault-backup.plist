<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.filip.aos-vault-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>__HOME__/agentic-os/scripts/backup_vault.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__HOME__/agentic-os/data/logs/aos-vault-backup.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/agentic-os/data/logs/aos-vault-backup.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>23</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__HOME__/agentic-os</string>
</dict>
</plist>
